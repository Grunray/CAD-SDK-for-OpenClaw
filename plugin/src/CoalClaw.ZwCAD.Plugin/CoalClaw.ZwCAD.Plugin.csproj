<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CoalClaw.ZwCAD.Plugin</RootNamespace>
    <!-- 程序集名不得与命名空间前缀相同，否则 ZWCAD NETLOAD 无法解析 ExtensionApplication -->
    <AssemblyName>CoalClawZwCADPlugin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 单 DLL：ZWCAD 无法加载额外依赖程序集 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PluginApplication.cs" />
    <Compile Include="Infrastructure\ZwCadHostContext.cs" />
    <Compile Include="Infrastructure\ZwCadUiContext.cs" />
    <Compile Include="Infrastructure\ZwCadGeometryCompat.cs" />
    <Compile Include="Services\EntityFinder.cs" />
    <Compile Include="Services\ViewZoomService.cs" />
    <Compile Include="..\CoalClaw.Cad.Abstractions\ICadHostContext.cs" Link="Abstractions\ICadHostContext.cs" />
    <Compile Include="..\CoalClaw.Cad.Abstractions\Models\ApiModels.cs" Link="Abstractions\Models\ApiModels.cs" />
    <Compile Include="..\CoalClaw.Cad.Abstractions\Models\CadHostMetadata.cs" Link="Abstractions\Models\CadHostMetadata.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Api\ApiRouter.cs" Link="Core\Api\ApiRouter.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Http\HttpServerHost.cs" Link="Core\Http\HttpServerHost.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Http\NativeSocket.cs" Link="Core\Http\NativeSocket.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Json\SimpleJson.cs" Link="Core\Json\SimpleJson.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Runtime\CadRuntimeWriter.cs" Link="Core\Runtime\CadRuntimeWriter.cs" />
    <Compile Include="..\CoalClaw.Cad.Core\Services\ZoomCommandBuilder.cs" Link="Core\Services\ZoomCommandBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZwCadInstallDir)ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwManaged">
      <HintPath>$(ZwCadInstallDir)ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="GenerateLoadScript" AfterTargets="Build">
    <PropertyGroup>
      <_LoadScrLine>(command "._NETLOAD" "$([System.String]::Copy('$(TargetPath)').Replace('\','/'))")</_LoadScrLine>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)\..\..\load.zwcad.dev.scr"
      Lines="$(_LoadScrLine)"
      Overwrite="true" />
  </Target>

</Project>
