<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CoalClaw.ZwCAD.Plugin</RootNamespace>
    <!-- 程序集名不得与命名空间前缀相同，否则 ZWCAD NETLOAD 无法解析 ExtensionApplication -->
    <AssemblyName>CoalClawZwCADPlugin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoalClaw.Cad.Abstractions\CoalClaw.Cad.Abstractions.csproj" />
    <ProjectReference Include="..\CoalClaw.Cad.Core\CoalClaw.Cad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZwCadInstallDir)ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwManaged">
      <HintPath>$(ZwCadInstallDir)ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="GenerateLoadScript" AfterTargets="Build">
    <PropertyGroup>
      <_LoadScrLine>(command "._NETLOAD" "$([System.String]::Copy('$(TargetPath)').Replace('\','/'))")</_LoadScrLine>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)\..\..\load.zwcad.dev.scr"
      Lines="$(_LoadScrLine)"
      Overwrite="true" />
  </Target>

</Project>
